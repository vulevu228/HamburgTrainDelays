	column 'Bucket Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4b82c358-87d3-5eaf-b325-4ee65ddcfb08
		summarizeBy: none
		sourceColumn: Bucket Order

		annotation SummarizationSetBy = Automatic

	partition Delays = m
		mode: import
		source =
				let
				    // one row per train arriving at Hamburg Hbf (DB Timetables API, collected every 15 min)
				    Source = Csv.Document(File.Contents("C:\Users\emira\Projects\GitHub-Projects\HamburgTrainDelays\hamburg_delays.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Headers, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {
				        {"check_time", type datetime}, {"train_id", type text}, {"category", type text},
				        {"line", type text}, {"train_no", type text}, {"planned_arr", type datetime},
				        {"actual_arr", type datetime}, {"delay_min", Int64.Type}, {"cancelled", Int64.Type},
				        {"platform", type text}, {"origin", type text}, {"source", type text}, {"station", type text}}, "en-US"),
				    Arrival = Table.AddColumn(Typed, "ArrivalTime", each if [planned_arr] <> null then [planned_arr] else [actual_arr], type datetime),
				    AddDate = Table.AddColumn(Arrival, "ArrivalDate", each DateTime.Date([ArrivalTime]), type date),
				    AddHour = Table.AddColumn(AddDate, "Hour", each Time.Hour([ArrivalTime]), Int64.Type),
				    // 8 Sep 2026 = continuous collection starts; today is always a partial day
				    Window = Table.SelectRows(AddHour, each [ArrivalDate] <> null and [ArrivalDate] >= #date(2026, 9, 8) and [ArrivalDate] < Date.From(DateTime.LocalNow())),
				    // below -10 min = timetable change, not an early train
				    CleanDelay = Table.TransformColumns(Window, {{"delay_min", each if _ <> null and _ < -10 then null else _, Int64.Type}}),
				    // rows from before 13 Oct 2026 have no station: they all come from the main hall
				    Station = Table.TransformColumns(CleanDelay, {{"station", each if _ = null then "Hamburg Hbf" else _, type text}}),
				    Service = Table.AddColumn(Station, "Service", each
				        if [station] = "Hamburg Hbf (S-Bahn)" or [category] = "S" then "S-Bahn"
				        else if List.Contains({"ICE", "IC", "EC", "ECE", "RJ", "NJ", "EN", "FLX", "D"}, [category]) then "Long-distance"
				        else if List.Contains({"RE", "RB", "ME", "NBE", "ERX"}, [category]) or Text.StartsWith(if [line] = null then "" else [line], "R") then "Regional"
				        else "Other", type text),
				    Bucket = Table.AddColumn(Service, "Delay Bucket", each
				        if [delay_min] = null then null
				        else if [delay_min] <= 0 then "Early / exact"
				        else if [delay_min] <= 5 then "1–5 min"
				        else if [delay_min] <= 15 then "6–15 min"
				        else if [delay_min] <= 30 then "16–30 min"
				        else if [delay_min] <= 60 then "31–60 min"
				        else "60+ min", type text),
				    BucketOrder = Table.AddColumn(Bucket, "Bucket Order", each
				        if [delay_min] = null then null
				        else if [delay_min] <= 0 then 1
				        else if [delay_min] <= 5 then 2
				        else if [delay_min] <= 15 then 3
				        else if [delay_min] <= 30 then 4
				        else if [delay_min] <= 60 then 5
				        else 6, Int64.Type),
				    Result = Table.RemoveColumns(BucketOrder, {"check_time", "source"})
				in
				    Result

	annotation PBI_ResultType = Table

