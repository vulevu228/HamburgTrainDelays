	column 'Week Start'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 7560f23c-f0b5-572e-9bf2-129ae2592f71
		summarizeBy: none
		sourceColumn: Week Start

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Calendar = m
		mode: import
		source =
				let
				    // 8 Sep 2026 up to yesterday (same window as Delays)
				    StartDate = #date(2026, 9, 8),
				    EndDate = Date.AddDays(Date.From(DateTime.LocalNow()), -1),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    #"To Table" = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"To Table", {{"Date", type date}}),
				    #"Added Weekday" = Table.AddColumn(#"Changed Type", "Weekday", each Date.ToText([Date], "ddd", "en-GB"), type text),
				    #"Added Weekday No" = Table.AddColumn(#"Added Weekday", "Weekday No", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
				    #"Added Week Start" = Table.AddColumn(#"Added Weekday No", "Week Start", each Date.StartOfWeek([Date], Day.Monday), type date)
				in
				    #"Added Week Start"

	annotation PBI_ResultType = Table
